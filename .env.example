# Copy to .env for local development. Replace placeholders with locally managed values.
# Never commit .env or put real credentials in this file.
DATABASE_URL=postgresql+psycopg://samadhan:change-me@localhost:5432/samadhan
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
JWT_ISSUER=https://identity.example.invalid
JWT_AUDIENCE=samadhan-api
APP_ENV=local
# Optional model configuration. Analysis fails explicitly until the key is set.
OPENAI_API_KEY=
COMPLAINT_ANALYST_MODEL=gpt-6-luna
COMPLAINT_ANALYST_TIMEOUT_SECONDS=30
COMPLAINT_ANALYST_CATEGORIES=roads_potholes,garbage_sanitation,drainage_sewage,water_leakage,streetlights_electrical,damaged_public_infrastructure,other_uncertain
